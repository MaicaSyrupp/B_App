{
  "nodeModulesDir": "auto",
  "imports": {
    "express": "npm:express@^4.19.2",
    "cors": "npm:cors@^2.8.6",
    "dotenv": "npm:dotenv@^16.4.5",
    "dotenv/": "npm:dotenv@^16.4.5/",
    "@prisma/client": "npm:@prisma/client@^6.19.3",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^6.19.3",
    "pg": "npm:pg@^8.22.0",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.110.6"
  },
  "tasks": {
    "dev": "deno run -A --env=.env --watch src/index.ts",
    "db:generate": "deno run -A --env=.env npm:prisma generate",
    "db:migrate": "deno run -A --env=.env npm:prisma migrate dev",
    "db:studio": "deno run -A --env=.env npm:prisma studio"
  }
}
