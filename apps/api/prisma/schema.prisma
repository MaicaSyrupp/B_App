generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "deno"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  supabaseId String   @unique
  email      String   @unique
  name       String
  role       Role?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  TEACHER
  STUDENT
}
